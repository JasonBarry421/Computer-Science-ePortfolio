<!-- res/drawable/textview_border.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle"
    android:id="@+id/outlineBorderWithCurvedEdges">

    <solid android:color="@color/cellBackgroundColor" />
    <stroke
        android:width="1dp"
        android:color="@color/cellOutlineColor" />
    <corners android:radius="6dp" />
    <padding
        android:left="12dp"
        android:top="8dp"
        android:right="12dp"
        android:bottom="8dp" />
</shape>