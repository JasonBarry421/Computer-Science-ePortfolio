<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/eventDailyRecyclerView"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/outline_text_view_curved_edges">

    <TextView
        android:id="@+id/eventHourlyText"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:text="12:00 AM"
        android:textStyle="bold"
        style="@style/textColorAndSize"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.25" />

    <LinearLayout
        android:id="@+id/eventContainer"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:gravity="center"
        android:padding="8dp"
        android:text="Event Container"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@id/eventHourlyText"
        app:layout_constraintRight_toRightOf="parent"
        />
</androidx.constraintlayout.widget.ConstraintLayout>