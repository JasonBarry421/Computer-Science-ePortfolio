<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".Calendar.View.activity_calendar_daily"

    style="@style/primaryBackground"
    tools:ignore="DiscouragedApi">

    <LinearLayout
        android:id="@+id/TopLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/outline_text_view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="20dp"
        android:layout_marginTop="0dp">

        <Button
            android:id="@+id/previousDayButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_weight="1"
            android:text="@string/calendarLeftButton"
            android:onClick="previousDayClick"
            style="@style/CalendarArrowColorAndSize"
            android:background="@color/transparent"/>

        <TextView
            android:id="@+id/monthAndDay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="September 18"
            android:maxLines="1"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAlignment="center" />

        <Button
            android:id="@+id/nextDayButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_weight="1"
            android:text="@string/calendarRightButton"
            android:onClick="nextDayClick"
            style="@style/CalendarArrowColorAndSize"
            android:background="@color/transparent"
            />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dailyRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/TopLinearLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <ImageButton
        android:id="@+id/AddEventButtonDailyVersion"
        android:layout_width="100dp"
        android:layout_height="130dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="25dp"
        android:src="@drawable/ic_circle_with_plus_sign"
        android:contentDescription="@drawable/ic_circle_with_plus_sign"
        android:background="@color/transparent" />

</androidx.constraintlayout.widget.ConstraintLayout>