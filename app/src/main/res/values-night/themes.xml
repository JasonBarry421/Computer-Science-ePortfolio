<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CS360FinalProjectByJasonBarry" parent="Theme.Material3.DayNight">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
    </style>

    <style name="primaryBackground">
        <item name="android:background">@color/black</item>
    </style>

    <style name="transparentBG">
        <item name="android:background">@color/transparent</item>
    </style>

    <style name="BarBackgroundColor">
        <item name="android:background">@color/gray</item>
    </style>

    <style name="CalendarArrowColorAndSize">
        <item name="android:textColor">@color/orange</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="textColorAndSize">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="textColor">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="saveButtonColor">
        <item name="android:backgroundTint">@color/light_blue</item>
    </style>

    <style name="CalenderDayMondayAbbreviation">
        <item name="android:layout_width">50dp</item>
        <item name="android:text">M</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="CalenderDayTuesdayAndThursdayAbbreviation">
        <item name="android:layout_width">50dp</item>
        <item name="android:text">T</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="CalenderDayWednesdayAbbreviation">
        <item name="android:layout_width">50dp</item>
        <item name="android:text">W</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="CalenderDayFridayAbbreviation">
        <item name="android:layout_width">50dp</item>
        <item name="android:text">F</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="CalenderDaySundayAndSaturdayAbbreviation">
        <item name="android:layout_width">50dp</item>
        <item name="android:text">S</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="CalendarDay">
        <item name="android:layout_width">50dp</item>
        <item name="android:layout_height">100dp</item>
        <item name="android:text">day</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">20sp</item>
    </style>

    <color name="cellBackgroundColor">@color/black</color>
    <color name="cellOutlineColor">@color/white</color>
</resources>